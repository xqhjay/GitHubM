<?xml version="1.0" encoding="utf-8"?>
<!--
  LinearLayout（竖向）：
    - WebView：填充剩余空间，显示 Web 应用内容
    - BottomNavigationView：固定在底部，高度由 M3 组件决定（wrap_content），映射核心导航功能
  splashOverlay 叠加于整个布局顶层，启动时遮盖初始化闪烁。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主体：状态栏占位 + WebView + 底部导航栏垂直排列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
          系统状态栏占位符：高度由 WindowInsets statusBars().top 动态设置。
          确保 WebView 内容从状态栏下方开始，避免与状态栏图标重叠。
          启动画面期间状态栏被隐藏，insets = 0，spacer 高度 = 0，不占空间。
          dismissSplash 后状态栏恢复显示，insets 更新，spacer 自动撑开正确高度。
        -->
        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/main_bg" />

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--
          ══ 底部导航容器 ═════════════════════════════════════════════
          结构：顶部分割线 + BottomNavigationView（64dp）+ navBarSpacer

          高度说明（labeled 模式，紧凑规格）：
            高度固定 64dp，介于 M3 默认的 80dp（过高、图标与文字间距大）
            与历史值 62dp（过低、label 上移压住图标、真机表现为文字与图标重叠）之间。
            app:itemPaddingTop/Bottom 各收至 6dp（M3 默认 8dp），
            用于压缩图标与文字之间的间隙，配合 20dp 图标 + 10sp 文字。

          Active Indicator：
            透明色，选中状态仅通过图标/文字强调色区分，
            点击涟漪效果覆盖整个 item 区域（图标+文字视为整体）。

          不使用 updatePadding(bottom)：系统导航条高度由 navBarSpacer 独立承接。
        -->
        <LinearLayout
            android:id="@+id/bottomNavContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bottom_nav_background"
            android:elevation="8dp">

            <!-- 顶部分割线：1dp 高，与 Web 端 border token 对齐 -->
            <View
                android:id="@+id/navDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/bottom_nav_divider" />

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                style="@style/Widget.Material3.BottomNavigationView"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@android:color/transparent"
                app:menu="@menu/bottom_nav_menu"
                app:itemIconTint="@color/bottom_nav_colors"
                app:itemTextColor="@color/bottom_nav_colors"
                app:itemTextAppearanceActive="@style/BottomNavTextActive"
                app:itemTextAppearanceInactive="@style/BottomNavTextInactive"
                app:itemIconSize="20dp"
                app:itemPaddingTop="6dp"
                app:itemPaddingBottom="6dp"
                app:itemActiveIndicatorStyle="@style/BottomNavActiveIndicator"
                app:labelVisibilityMode="labeled"
                app:elevation="0dp" />

            <!-- 系统导航条占位符：由 WindowInsets 动态设置高度，不影响 BottomNavView 布局 -->
            <View
                android:id="@+id/navBarSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@color/bottom_nav_background" />

        </LinearLayout>

    </LinearLayout>

    <!-- 启动遮罩：全屏启动画面，WebView 就绪后淡出 -->
    <include
        android:id="@+id/splashOverlay"
        layout="@layout/splash_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>

